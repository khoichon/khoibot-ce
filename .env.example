# Optional API key for the moderation service.
BADWORD_API_KEY=

# Optional desktop Ollama configuration. Set USE_DESKTOP_AI=1 to try the desktop
# first; the bot falls back to local Ollama if the desktop is unavailable.
USE_DESKTOP_AI=0
DESKTOP_AI_HOST=http://localhost:11434
DESKTOP_AI_MODEL=qwen3:8b
LOCAL_AI_MODEL=qwen3:8b

# Enable thinking for the desktop Ollama model.
DESKTOP_AI_THINK=0

# !ai uses the models above. It forgets a chat's conversation after this many
# minutes without a message. Defaults to 60.
AI_HISTORY_TIMEOUT=60

# how long ollama keeps the !ai model loaded after the last message. a longer
# time means no slow reload between chats. use 0 to unload straight away.
# defaults to 30m.
AI_KEEP_ALIVE=30m

# Storage backend: file (default), mysql, mariadb, redis, postgres or supabase.
# The file backend needs no URL (repo-root bot-config.json); other backends
# require their driver: npm install mysql2 / ioredis / pg (all are optional
# dependencies and normally installed automatically).
STORAGE_BACKEND=file

# Connection URL for the selected backend. Examples:
#   mysql://user:pass@localhost:3306/khoibot
#   mariadb://user:pass@localhost:3306/khoibot
#   redis://localhost:6379/0            (rediss://... for TLS)
#   postgres://user:pass@host:5432/postgres
#
# Supabase: use the POOLER connection string (Project Settings -> Database ->
# Connection pooling), not the direct db.<ref>.supabase.co host — the direct
# host is IPv6-only on current projects and unreachable from IPv4-only
# networks. Pooler format (note the postgres.<project-ref> username):
#   postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:5432/postgres
STORAGE_URL=

# Optional key prefix for the redis backend (default khoibot:v1).
# STORAGE_REDIS_PREFIX=khoibot:v1

# Set to 1 to enable the extra games (!coin, !roll, !rps, !ttt, !numguess,
# !wordle, !anagram, !hotpotato). Off by default.
ENABLE_EXTRA_GAMES=0

# Hint limits for the games. Each game allows 2 hints. A hint only works after
# HINT_START_DELAY_SECONDS have passed since the game started, and each one after
# that waits HINT_COOLDOWN_SECONDS since the last hint. Both default to 30, and
# 0 turns that wait off.
# HINT_START_DELAY_SECONDS=30
# HINT_COOLDOWN_SECONDS=30

# Set to 1 to enable the extra commands (!fact, !joke, !define, !wiki,
# !translate, !quote, !tts, !sticker, !animsticker, !automute, !autounmute).
# Off by default. !animsticker needs ffmpeg installed on the machine.
ENABLE_EXTRA_COMMANDS=0

# With the extra commands on, a person gets a warning when more than this many
# of their messages are deleted for cursing within the time below. 0 turns it
# off. A group can change its own number with !mod warncurses.
WARN_CURSES_DEFAULT=5

# How many minutes the curse messages are counted over before the count goes
# back to 0 (1 to 60). A group can change its own with !mod warncursestime.
WARN_CURSES_TIME_DEFAULT=5

# Phone numbers (country code first, digits only, like 6512345678) that can never use the bot in any chat. Separate them with commas. More can be added from chat with !special forceban. Trusted users can't be force banned.
FORCE_BANNED=

# Set to 1 to enable the anti-ban protections: a delay with the typing
# indicator before each message, message rate limits, command cooldowns,
# ignoring old messages, and a wait before reconnecting. This also turns on
# !messagedelay, !messagecooldown, !bot and !antiban. Off by default.
ENABLE_ANTIBAN=0

# Set to 1 (together with ENABLE_ANTIBAN=1) for the extra anti-ban features: a
# ban risk score that slows the bot down and then pauses it when things look
# bad (disconnects, 403s, failed sends), repeated messages get tiny changes so
# they aren't identical, and a per-chat queue with priorities and 2 retries.
# Does nothing without ENABLE_ANTIBAN=1. Off by default.
ENABLE_ANTIBAN_PLUS=0

# Set to 1 to let the bot update itself. It checks GitHub for new commits, pulls them, runs pm2 save
# and restarts so pm2 brings it back up. Off by default.
ENABLE_AUTO_DEPLOY=0

# How often it checks, in minutes (default 2).
# AUTO_DEPLOY_MINUTES=2

# Optional anti-ban settings. The values shown are the defaults.
# Range of the message delay, in seconds:
# MESSAGE_DELAY_DEFAULT_MIN=1
# MESSAGE_DELAY_DEFAULT_MAX=3
# Maximum messages the bot sends per minute and per hour:
# ANTIBAN_MAX_PER_MINUTE=20
# ANTIBAN_MAX_PER_HOUR=300
# Seconds a person must wait between commands (normal and heavy commands):
# ANTIBAN_COMMAND_COOLDOWN=3
# ANTIBAN_HEAVY_COOLDOWN=10
# Maximum !pfp lookups per hour across all users:
# ANTIBAN_PFP_PER_HOUR=30
# Maximum size of a !plot request, in expressions and characters:
# ANTIBAN_PLOT_MAX_EXPRESSIONS=10
# ANTIBAN_PLOT_MAX_CHARS=500
# Messages older than this many seconds are ignored:
# ANTIBAN_MAX_MESSAGE_AGE=60
# Longest wait between reconnect attempts, in seconds:
# ANTIBAN_RECONNECT_MAX=300

# Optional. Time zone for !automute and !autounmute. Defaults to Asia/Singapore.
# EXTRA_TIMEZONE=Asia/Singapore

# Set to 1 to give every console line a timestamp, a level and a tag, and to
# show incoming messages as [DD/MM/YY HH:MM:SS] <sender> <GRP: group name or DM>
# <message>. Set to 0 (or leave it out) to keep the original output. The time
# uses EXTRA_TIMEZONE. The four options below only apply when this is 1.
# Colours are used only in a terminal. Under PM2, set FORCE_COLOR=1 to keep them,
# or NO_COLOR=1 to turn them off.
ENABLE_BETTER_LOGGING=0

# Show the sender's phone number. Set to 0 to show the LID instead.
ENABLE_SHOW_PH=1

# Show the group name. Set to 0 to show only <GRP>. Direct messages show <DM>.
ENABLE_SHOW_GRP=1

# Show the sender's WhatsApp name in brackets next to their number, and next to
# mentions of them. Set to 0 to leave the names out. Defaults to 1.
ENABLE_SHOW_NAME=1

# Show the message text. Set to 0 to leave it out. Defaults to 1.
ENABLE_SHOW_MESSAGE=1

# Log colours. They only matter with ENABLE_BETTER_LOGGING=1, and only where
# colours actually show. Pick red, green, yellow, blue, magenta, cyan, white,
# gray, teal or dim, or none for no colour. If a value is empty or misspelled the
# default below is used.
LOG_COLOR_TIME=dim
LOG_COLOR_TAG=cyan
LOG_COLOR_INFO=green
LOG_COLOR_WARN=yellow
LOG_COLOR_ERROR=red

# Colours for the phone number and the group name on message lines.
LOG_COLOR_PHONE=cyan
LOG_COLOR_GROUP=teal

# colour of the bot's reply under each command. needs ENABLE_BETTER_LOGGING=1
# and ENABLE_SHOW_MESSAGE=1, otherwise replies aren't logged.
LOG_COLOR_REPLY=green

# !ai imagine draws pictures with stable diffusion webui running on the desktop
# set this to 1 to allow it. each chat still needs a trusted user to run !ai imagine toggle
ENABLE_AI_IMAGINE=0
# where the webui lives. it has to be started with --api. use the desktops ip, not localhost, since the pi is a different machine
DESKTOP_IMAGINE_HOST=http://localhost:7860
# optional, these are the defaults. more steps and a bigger size means nicer pictures but a longer wait
IMAGINE_STEPS=20
IMAGINE_WIDTH=512
IMAGINE_HEIGHT=512
