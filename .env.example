# Optional API key for the moderation service.
BADWORD_API_KEY=

# Optional desktop Ollama configuration. Set USE_DESKTOP_AI=1 to try the desktop
# first; the bot falls back to local Ollama if the desktop is unavailable.
USE_DESKTOP_AI=0
DESKTOP_AI_HOST=http://localhost:11434
DESKTOP_AI_MODEL=qwen3:8b
LOCAL_AI_MODEL=qwen3:8b

# Enable thinking for the desktop Ollama model.
DESKTOP_AI_THINK=0

# Storage backend: file (default), mysql, mariadb, redis, postgres or supabase.
# The file backend needs no URL (repo-root bot-config.json); other backends
# require their driver: npm install mysql2 / ioredis / pg (all are optional
# dependencies and normally installed automatically).
STORAGE_BACKEND=file

# Connection URL for the selected backend. Examples:
#   mysql://user:pass@localhost:3306/khoibot
#   mariadb://user:pass@localhost:3306/khoibot
#   redis://localhost:6379/0            (rediss://... for TLS)
#   postgres://user:pass@host:5432/postgres
#
# Supabase: use the POOLER connection string (Project Settings -> Database ->
# Connection pooling), not the direct db.<ref>.supabase.co host — the direct
# host is IPv6-only on current projects and unreachable from IPv4-only
# networks. Pooler format (note the postgres.<project-ref> username):
#   postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:5432/postgres
STORAGE_URL=

# Optional key prefix for the redis backend (default khoibot:v1).
# STORAGE_REDIS_PREFIX=khoibot:v1

# Set to 1 to enable the extra games (!coin, !roll, !rps, !ttt, !numguess,
# !wordle, !anagram). Off by default.
ENABLE_EXTRA_GAMES=0
